# ── Core ───────────────────────────────────────────────────────────────
ENVIRONMENT=development              # development | staging | production
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ── Security ───────────────────────────────────────────────────────────
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_dev_only_secret_key_min_32_chars_long_xxxx
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
NODE_REQUEST_MAX_SKEW_SECONDS=60

# ── Datastores ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_civilization
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://localhost:6379/0

# ── Rate limiting ──────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=20

# ── CORS ───────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Execution / sandbox ────────────────────────────────────────────────
SANDBOX_BACKEND=subprocess           # subprocess только dev/test; production требует docker
SANDBOX_MAX_CPU_SECONDS=10
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_MAX_WALL_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=65536
WORKER_POLL_INTERVAL_SECONDS=2

# ── Production hardening ───────────────────────────────────────────────
# Доверенные обратные прокси (точные IP/CIDR, через запятую).
# Пусто — заголовок X-Forwarded-For НЕ доверяется (рекомендуется, если нет прокси).
TRUSTED_PROXIES=
# Короткоживущий тикет для браузерного WebSocket (сек).
WS_TICKET_TTL_SECONDS=60
# Fail-closed anti-replay при недоступном Redis (пусто = по умолчанию: true в staging/production).
ANTI_REPLAY_FAIL_CLOSED=
# Обязателен в production: сервисный токен внутреннего API доставки сообщений.
INTERNAL_SERVICE_TOKEN=
