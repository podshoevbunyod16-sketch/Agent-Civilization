# ═══════════════════════════════════════════════════════════════════════
# Agent Civilization — пример конфигурации.
#
# Правило этапа 10: в production приложение НЕ запускается в небезопасной
# конфигурации. Проверки выполняются при старте (`validate_for_runtime`) и
# перечислены в docs/PRODUCTION_CHECKLIST.md §1. Значения по умолчанию в
# этом файле безопасны для разработки, а не для production.
# ═══════════════════════════════════════════════════════════════════════

# ── Core ───────────────────────────────────────────────────────────────
ENVIRONMENT=development              # development | staging | production
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# Публичный адрес фронтенда: используется в ссылках подтверждения email и
# сброса пароля. В production обязателен https (проверяется при старте).
PUBLIC_BASE_URL=http://localhost:5173

# ── Подпись токенов ────────────────────────────────────────────────────
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Production: ≥ 32 символов, не содержать "change-me". Проверяется при старте.
SECRET_KEY=CHANGE_ME_dev_only_secret_key_min_32_chars_long_xxxx
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
NODE_REQUEST_MAX_SKEW_SECONDS=60

# ── Шифрование секретов (этап 10, C) ───────────────────────────────────
# Кольцо ключей AES-256-GCM: "1:<base64 32 байта>,2:<base64>". Активна
# старшая версия, старые нужны для чтения уже сохранённых секретов.
# Generate: python -c "import base64,os;print('1:'+base64.b64encode(os.urandom(32)).decode())"
# В production обязателен: ключи не должны выводиться из SECRET_KEY.
SECRET_ENCRYPTION_KEYS=
# Мастер-ключ бэкапов: отдельный от SECRET_KEY. Пусто — выводится из SECRET_KEY
# (только для dev).
BACKUP_ENCRYPTION_KEY=

# ── Datastores ─────────────────────────────────────────────────────────
# В production требуется sslmode=require (проверка выполняется на стороне
# драйвера; параметр добавляется к URL).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_civilization
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://localhost:6379/0

# ── Rate limiting (этап 10, A #5–#6) ───────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=240     # чтение, ключ — аккаунт или IP
RATE_LIMIT_AUTH_PER_MINUTE=20         # вход/регистрация, ключ — IP
RATE_LIMIT_WRITE_PER_MINUTE=120       # изменяющие операции
RATE_LIMIT_CRITICAL_PER_MINUTE=20     # деньги, секреты, бэкап, 2FA
RATE_LIMIT_NODE_PER_MINUTE=1200       # подписанные запросы узлов

# Доверенные прокси (CIDR через запятую). X-Forwarded-For читается ТОЛЬКО
# от них; иначе клиент мог бы подделать IP и обойти лимиты. Пусто — заголовок
# игнорируется полностью.
TRUSTED_PROXIES=

# ── CORS ───────────────────────────────────────────────────────────────
# В production только https-адреса, без "*" (проверяется при старте).
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Учётные записи и 2FA (этап 10, B) ──────────────────────────────────
EMAIL_VERIFICATION_REQUIRED=false     # true в production: деньги/секреты — после подтверждения
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800
TOTP_ISSUER=Agent Civilization
MFA_ENFORCED_ROLES=admin              # роли, которым 2FA обязательна
LOGIN_MAX_ATTEMPTS=10                 # блокировка по аккаунту после серии неудач
LOGIN_LOCKOUT_SECONDS=900

# Доставка писем: console (dev/test) | smtp (production).
# При EMAIL_VERIFICATION_REQUIRED=true режим console запрещён: иначе
# пользователь никогда не подтвердит адрес.
EMAIL_DELIVERY=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@agent-civilization.local
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# ── Внутренний API ─────────────────────────────────────────────────────
# Токен для воркеров доставки. В production обязателен: без него внутренний
# API отключён (403), и сообщения не доставляются.
INTERNAL_SERVICE_TOKEN=dev-internal-token-2026

# ── Execution / sandbox ────────────────────────────────────────────────
SANDBOX_BACKEND=subprocess           # production: docker (проверяется при старте)
SANDBOX_MAX_CPU_SECONDS=10
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_MAX_WALL_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=65536
# Сетевой доступ из задания. В production должен быть false (проверяется).
SANDBOX_ALLOW_NETWORK=false
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=60
ARTIFACT_STORAGE_DIR=./var/artifacts

# ── Сетевые ограничения (этап 10, A #7) ────────────────────────────────
# Разрешать исходящие запросы во внутренние сети. Только dev/test:
# в production true запрещён проверкой конфигурации.
SSRF_ALLOW_PRIVATE=false
OUTBOUND_TIMEOUT_SECONDS=10

# ── Бэкапы (этап 10, F) ────────────────────────────────────────────────
# В production каталог монтируется отдельным томом (не на диске БД).
BACKUP_DIR=./var/backups
BACKUP_KEEP_DAYS=14
# Интервал демона бэкапа; 0 — выключен (запуск вручную).
BACKUP_INTERVAL_SECONDS=0
RPO_TARGET_SECONDS=3600
RTO_TARGET_SECONDS=1800

# ── Наблюдаемость ──────────────────────────────────────────────────────
# /metrics без токена: удобно внутри кластера, но раскрывает нагрузку.
METRICS_PUBLIC=false
NODE_STALE_AFTER_SECONDS=120

# ── Прочие параметры (обычно менять не нужно) ──────────────────────────
PROJECT_NAME=Agent Civilization
VERSION=1.0.0
DATABASE_ECHO=false
PASSWORD_MIN_LENGTH=8
REGISTRY_PAGE_SIZE_DEFAULT=20
REGISTRY_PAGE_SIZE_MAX=100
SANDBOX_PYTHON_IMAGE=python:3.12-slim
OUTBOUND_MAX_REDIRECTS=0
MESSAGE_MAX_ATTEMPTS=3
MESSAGE_WORKER_POLL_INTERVAL_SECONDS=1
MAINTENANCE_INTERVAL_SECONDS=30
TOTP_WINDOW=1
