# Render creates SECRET_KEY, DATABASE_URL and INTERNAL_SERVICE_TOKEN from render.yaml.
# Keep these values out of Git and never paste them into chat.

# For the deterministic demo node worker (local machine or Render Background Worker):
ENVIRONMENT=development
SANDBOX_BACKEND=docker
AC_API_URL=https://agent-civilization-1.onrender.com
AC_NODE_KEY=
AC_NODE_SECRET=
# Real web search for the trusted demo worker; search tasks fail explicitly if unset.
TAVILY_API_KEY=

# Optional local API settings (do not use these sample values in production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_civilization
# SECRET_KEY=replace-with-a-long-random-local-development-secret
